{
  "name": "harissa-media-player",
  "private": true,
  "version": "1.0.0",
  "description": "A fast, private media player for local audio and video.",
  "author": "Bechir Lahoueg",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "music-metadata": "^11.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1"
  },
  "build": {
    "appId": "com.harissa.player",
    "productName": "Harissa Media Player",
    "copyright": "Copyright © 2026 Bechir Lahoueg",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "public/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Harissa Media Player",
      "perMachine": false
    },
    "compression": "maximum",
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "m4v",
          "mkv",
          "webm",
          "mov",
          "avi",
          "ogv"
        ],
        "name": "Video",
        "description": "Video file",
        "role": "Viewer",
        "icon": "build/icon.ico"
      },
      {
        "ext": [
          "mp3",
          "m4a",
          "aac",
          "wav",
          "flac",
          "ogg",
          "oga",
          "opus",
          "weba"
        ],
        "name": "Audio",
        "description": "Audio file",
        "role": "Viewer",
        "icon": "build/icon.ico"
      }
    ]
  }
}
